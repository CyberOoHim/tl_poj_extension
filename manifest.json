{
  "manifest_version": 3,
  "name": "TL -> POJ 隨時轉",
  "version": "1.0",
  "description": "Instant Tâi-lô Pheng-im (TL) to Taiwanese Pe̍h-ōe-jī (POJ) converter / 隨時 kā 網頁、拍字、文件 ê 台羅拼音 (TL) 轉做台語白話字 (POJ)。100% 在地走，保證隱私。",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "sidePanel",
    "tabs",
    "clipboardRead",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TL -> POJ 隨時轉"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ui_config.js",
        "turndown.js",
        "turndown-plugin-gfm.js",
        "converter.js",
        "content_script.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/ChiayiCity.ttf",
        "fonts/jf-openhuninn-2.1.ttf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}